# Muushig server configuration (copy to .env; .env is gitignored).

# Port the Colyseus server listens on.
PORT=2567

# Optional: enable Redis presence/driver for horizontal scale.
# When unset, the server runs single-process (fine for local dev).
# REDIS_URL=redis://localhost:6379

# Node environment.
NODE_ENV=development

# Supabase (server side) — Project Settings → API.
# The service-role key bypasses row-level security; KEEP IT SECRET (server only).
# Leave unset to run guest games with no accounts / stats.
# SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY
