# Muushig server configuration (copy to .env; .env is gitignored).

# Port the Colyseus server listens on.
PORT=2567

# Optional: enable Redis presence/driver for horizontal scale.
# When unset, the server runs single-process (fine for local dev).
# REDIS_URL=redis://localhost:6379

# Node environment.
NODE_ENV=development

# Discord Embedded App OAuth — for real usernames, speaking rings, rich presence.
# CLIENT_ID is the public Discord application id (same value as the client's
# VITE_DISCORD_CLIENT_ID); the SECRET is from the Developer Portal → OAuth2 and
# must stay server-only. Leave unset to run with guest names (no OAuth).
# DISCORD_CLIENT_ID=YOUR-DISCORD-APP-ID
# DISCORD_CLIENT_SECRET=YOUR-DISCORD-CLIENT-SECRET

# Supabase (server side) — Project Settings → API.
# The service-role key bypasses row-level security; KEEP IT SECRET (server only).
# Leave unset to run guest games with no accounts / stats.
# SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY
